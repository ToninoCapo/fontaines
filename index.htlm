<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1a3a6b">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Fontaines GRE">
<title>Suivi Fontaines — Ville de Grenoble</title>
<link rel="manifest" href="#" id="manifest-link">
<link href="https://fonts.googleapis.com/css2?family=Marianne:wght@400;500;700&family=Source+Sans+3:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --vert:    #007a4d;
    --vert2:   #005c39;
    --bleu:    #1a3a6b;
    --bleu2:   #0e2448;
    --blanc:   #ffffff;
    --gris0:   #f5f6f7;
    --gris1:   #e8eaed;
    --gris2:   #b0b8c1;
    --gris3:   #6b7a8d;
    --texte:   #1c2833;
    --rouge:   #c0392b;
    --orange:  #e67e22;
    --jaune:   #f0c040;
    --shadow:  0 2px 12px rgba(26,58,107,0.10);
    --shadow2: 0 4px 24px rgba(26,58,107,0.16);
    --radius:  10px;
    --radius2: 16px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Source Sans 3', sans-serif;
    background: var(--gris0);
    color: var(--texte);
    min-height: 100vh;
    font-size: 15px;
  }

  /* ─── HEADER ─── */
  header {
    background: linear-gradient(135deg, var(--bleu) 0%, var(--bleu2) 100%);
    color: var(--blanc);
    padding: 0 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    height: 64px;
    box-shadow: var(--shadow2);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-logo {
    width: 40px; height: 40px;
    background: var(--vert);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  }
  .header-title { flex: 1 }
  .header-title h1 { font-size: 17px; font-weight: 700; letter-spacing: .3px; }
  .header-title p  { font-size: 11px; opacity: .75; margin-top: 1px; }
  .offline-badge {
    background: var(--orange);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 20px;
    display: none;
    letter-spacing: .5px;
  }
  .offline-badge.show { display: inline-block; }

  /* ─── NAVIGATION ─── */
  nav {
    background: var(--blanc);
    display: flex;
    border-bottom: 2px solid var(--gris1);
    position: sticky;
    top: 64px;
    z-index: 99;
    box-shadow: 0 2px 8px rgba(26,58,107,0.06);
    overflow-x: auto;
  }
  nav button {
    flex: 1;
    min-width: 80px;
    padding: 13px 8px 11px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 11px;
    font-weight: 600;
    color: var(--gris3);
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    border-bottom: 3px solid transparent;
    transition: all .2s;
    white-space: nowrap;
    letter-spacing: .3px;
    text-transform: uppercase;
  }
  nav button .nav-icon { font-size: 20px; }
  nav button.active { color: var(--bleu); border-bottom-color: var(--vert); }
  nav button:hover:not(.active) { color: var(--bleu); background: var(--gris0); }

  /* ─── MAIN ─── */
  main { padding: 20px 16px 100px; max-width: 800px; margin: 0 auto; }

  /* ─── SECTIONS ─── */
  .section { display: none; }
  .section.active { display: block; }

  /* ─── SECTEUR SELECTOR ─── */
  .secteur-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
    margin-bottom: 20px;
  }
  @media(max-width:500px){
    .secteur-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .secteur-btn {
    background: var(--blanc);
    border: 2px solid var(--gris1);
    border-radius: var(--radius);
    padding: 10px 4px;
    cursor: pointer;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    color: var(--gris3);
    text-align: center;
    transition: all .18s;
    box-shadow: var(--shadow);
  }
  .secteur-btn small { display: block; font-size: 10px; font-weight: 400; margin-top: 2px; color: var(--gris2); }
  .secteur-btn.active {
    background: var(--bleu);
    border-color: var(--bleu);
    color: var(--blanc);
    box-shadow: 0 4px 14px rgba(26,58,107,0.25);
  }
  .secteur-btn.active small { color: rgba(255,255,255,0.7); }
  .secteur-btn:hover:not(.active) { border-color: var(--bleu); color: var(--bleu); }

  /* ─── CARDS ─── */
  .card {
    background: var(--blanc);
    border-radius: var(--radius2);
    box-shadow: var(--shadow);
    overflow: hidden;
    margin-bottom: 16px;
  }
  .card-header {
    padding: 14px 18px 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--gris1);
  }
  .card-icon {
    width: 38px; height: 38px;
    border-radius: 10px;
    background: var(--bleu);
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .card-icon.vert { background: var(--vert); }
  .card-icon.orange { background: var(--orange); }
  .card-icon.rouge { background: var(--rouge); }
  .card-title { font-size: 15px; font-weight: 700; }
  .card-sub   { font-size: 12px; color: var(--gris3); margin-top: 2px; }
  .card-body  { padding: 16px 18px; }

  /* ─── FONTAINE LIST ─── */
  .fontaine-list { display: flex; flex-direction: column; gap: 10px; }
  .fontaine-item {
    background: var(--gris0);
    border: 1.5px solid var(--gris1);
    border-radius: var(--radius);
    padding: 13px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all .15s;
  }
  .fontaine-item:hover { border-color: var(--bleu); background: #eef2f8; }
  .fontaine-item .fi-name { font-weight: 700; font-size: 14px; flex: 1; }
  .fontaine-item .fi-sect {
    background: var(--bleu);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 20px;
  }
  .fontaine-item .fi-interv {
    font-size: 11px;
    color: var(--gris3);
  }
  .fontaine-item .fi-alert {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--gris2);
    flex-shrink: 0;
  }
  .fontaine-item .fi-alert.has-open { background: var(--orange); box-shadow: 0 0 0 3px rgba(230,126,34,0.2); }

  /* ─── FORM ─── */
  .form-group { margin-bottom: 14px; }
  .form-group label { display: block; font-size: 12px; font-weight: 700; color: var(--gris3); margin-bottom: 5px; text-transform: uppercase; letter-spacing: .5px; }
  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 10px 13px;
    border: 1.5px solid var(--gris1);
    border-radius: var(--radius);
    font-family: inherit;
    font-size: 14px;
    color: var(--texte);
    background: var(--gris0);
    transition: border .15s;
    outline: none;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--bleu);
    background: var(--blanc);
    box-shadow: 0 0 0 3px rgba(26,58,107,0.09);
  }
  .form-group textarea { resize: vertical; min-height: 80px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

  /* ─── BUTTONS ─── */
  .btn {
    padding: 11px 20px;
    border: none;
    border-radius: var(--radius);
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all .15s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    letter-spacing: .3px;
  }
  .btn-primary { background: var(--bleu); color: #fff; }
  .btn-primary:hover { background: var(--bleu2); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(26,58,107,0.3); }
  .btn-vert { background: var(--vert); color: #fff; }
  .btn-vert:hover { background: var(--vert2); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0,122,77,0.3); }
  .btn-ghost { background: transparent; color: var(--bleu); border: 1.5px solid var(--bleu); }
  .btn-ghost:hover { background: var(--bleu); color: #fff; }
  .btn-danger { background: var(--rouge); color: #fff; }
  .btn-sm { padding: 7px 13px; font-size: 12px; }
  .btn-block { width: 100%; justify-content: center; }

  /* ─── INTERVENTIONS ─── */
  .interv-list { display: flex; flex-direction: column; gap: 10px; }
  .interv-item {
    background: var(--gris0);
    border: 1.5px solid var(--gris1);
    border-radius: var(--radius);
    padding: 13px 16px;
    border-left: 4px solid var(--gris2);
  }
  .interv-item.open   { border-left-color: var(--orange); }
  .interv-item.closed { border-left-color: var(--vert); }
  .interv-header { display: flex; align-items: flex-start; gap: 10px; }
  .interv-date { font-size: 11px; font-weight: 700; color: var(--gris3); min-width: 80px; }
  .interv-desc { font-size: 13px; flex: 1; font-weight: 600; }
  .interv-status {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 20px;
    text-transform: uppercase;
  }
  .interv-status.open   { background: #fff3e0; color: var(--orange); }
  .interv-status.closed { background: #e8f5e9; color: var(--vert); }
  .interv-fontaine { font-size: 11px; color: var(--gris3); margin-top: 5px; }
  .interv-resolution { font-size: 12px; color: var(--vert2); margin-top: 4px; font-style: italic; }
  .interv-actions { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }

  /* ─── MODAL ─── */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.45);
    z-index: 200;
    display: flex; align-items: flex-end; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity .2s;
  }
  .modal-overlay.open { opacity: 1; pointer-events: all; }
  .modal {
    background: var(--blanc);
    border-radius: 20px 20px 0 0;
    width: 100%;
    max-width: 600px;
    max-height: 92vh;
    overflow-y: auto;
    transform: translateY(60px);
    transition: transform .25s cubic-bezier(.4,0,.2,1);
    padding-bottom: 30px;
  }
  .modal-overlay.open .modal { transform: translateY(0); }
  .modal-handle {
    width: 40px; height: 4px;
    background: var(--gris2);
    border-radius: 2px;
    margin: 12px auto 0;
  }
  .modal-header {
    padding: 16px 20px 14px;
    display: flex; align-items: center; gap: 12px;
    border-bottom: 1px solid var(--gris1);
  }
  .modal-header h2 { font-size: 17px; font-weight: 700; flex: 1; }
  .modal-close { width: 32px; height: 32px; border: none; background: var(--gris1); border-radius: 50%; cursor: pointer; font-size: 18px; display: flex; align-items: center; justify-content: center; }
  .modal-body { padding: 20px; }

  /* ─── STATS ─── */
  .stats-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; margin-bottom: 20px; }
  @media(min-width:500px){ .stats-grid { grid-template-columns: repeat(4,1fr); } }
  .stat-card {
    background: var(--blanc);
    border-radius: var(--radius2);
    padding: 16px 14px;
    box-shadow: var(--shadow);
    text-align: center;
  }
  .stat-val { font-size: 28px; font-weight: 700; color: var(--bleu); line-height: 1; }
  .stat-val.vert { color: var(--vert); }
  .stat-val.orange { color: var(--orange); }
  .stat-lbl { font-size: 11px; color: var(--gris3); margin-top: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: .4px; }

  /* ─── PDF EXPORT ─── */
  .export-filters { display: flex; flex-direction: column; gap: 12px; }
  .export-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .filter-chip {
    padding: 7px 14px;
    border-radius: 20px;
    border: 1.5px solid var(--gris1);
    background: var(--blanc);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all .15s;
    color: var(--gris3);
  }
  .filter-chip.active { background: var(--bleu); border-color: var(--bleu); color: #fff; }
  .filter-chip:hover:not(.active) { border-color: var(--bleu); color: var(--bleu); }

  /* ─── TOAST ─── */
  .toast {
    position: fixed;
    bottom: 80px; left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--texte);
    color: #fff;
    padding: 10px 20px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transition: all .3s;
    z-index: 500;
    white-space: nowrap;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .toast.success { background: var(--vert); }
  .toast.error   { background: var(--rouge); }

  /* ─── PAGE TITLE ─── */
  .page-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--bleu);
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .page-title span { font-size: 24px; }

  /* ─── EMPTY STATE ─── */
  .empty-state {
    text-align: center;
    padding: 40px 20px;
    color: var(--gris3);
  }
  .empty-state .es-icon { font-size: 48px; margin-bottom: 12px; }
  .empty-state h3 { font-size: 15px; font-weight: 700; margin-bottom: 6px; color: var(--gris3); }
  .empty-state p  { font-size: 13px; }

  /* ─── SEARCH ─── */
  .search-wrap { position: relative; margin-bottom: 16px; }
  .search-wrap input { padding-left: 40px; }
  .search-icon { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); font-size: 16px; color: var(--gris2); pointer-events: none; }

  /* ─── DETAIL VIEW ─── */
  .detail-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .back-btn {
    width: 36px; height: 36px;
    border: 1.5px solid var(--gris1);
    border-radius: 10px;
    background: var(--blanc);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    font-size: 18px;
    flex-shrink: 0;
  }

  /* ─── PRINT (PDF) ─── */
  @media print {
    header, nav, .btn, .modal-overlay, .toast, .no-print { display: none !important; }
    body { background: #fff; }
    main { padding: 0; max-width: 100%; }
    .section { display: block !important; }
    #section-pdf { display: block !important; }
    .pdf-content { display: block !important; }
  }

  /* ─── SCROLLBAR ─── */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: var(--gris0); }
  ::-webkit-scrollbar-thumb { background: var(--gris2); border-radius: 3px; }

  /* ─── FONTAINE DETAIL ─── */
  .fontaine-detail-header {
    background: linear-gradient(135deg, var(--bleu) 0%, var(--vert) 100%);
    border-radius: var(--radius2);
    padding: 20px;
    color: #fff;
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
  }
  .fontaine-detail-header::after {
    content: '⛲';
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 52px;
    opacity: .18;
  }
  .fdh-sect { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; opacity: .8; margin-bottom: 6px; }
  .fdh-name { font-size: 24px; font-weight: 700; }
  .fdh-stats { display: flex; gap: 20px; margin-top: 14px; }
  .fdh-stat { text-align: left; }
  .fdh-stat-val { font-size: 20px; font-weight: 700; }
  .fdh-stat-lbl { font-size: 10px; opacity: .75; text-transform: uppercase; letter-spacing: .5px; }

  /* Responsive */
  @media(max-width:400px){
    .form-row { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<header>
  <div class="header-logo">⛲</div>
  <div class="header-title">
    <h1>Suivi Fontaines</h1>
    <p>Ville de Grenoble — Service Hydraulique</p>
  </div>
  <span class="offline-badge" id="offline-badge">HORS LIGNE</span>
</header>

<nav>
  <button class="active" onclick="showSection('fontaines')" id="nav-fontaines">
    <span class="nav-icon">⛲</span>Fontaines
  </button>
  <button onclick="showSection('interventions')" id="nav-interventions">
    <span class="nav-icon">🔧</span>Interventions
  </button>
  <button onclick="showSection('ajouter')" id="nav-ajouter">
    <span class="nav-icon">➕</span>Nouveau
  </button>
  <button onclick="showSection('export')" id="nav-export">
    <span class="nav-icon">📄</span>Export PDF
  </button>
  <button onclick="showSection('dashboard')" id="nav-dashboard">
    <span class="nav-icon">📊</span>Tableau
  </button>
</nav>

<main>

  <!-- ══ SECTION FONTAINES ══ -->
  <div class="section active" id="section-fontaines">
    <div class="page-title"><span>⛲</span> Fontaines</div>

    <div class="secteur-grid" id="secteur-filter">
      <button class="secteur-btn active" data-sect="0" onclick="filterSecteur(0)">Tous<small>tous sect.</small></button>
      <button class="secteur-btn" data-sect="1" onclick="filterSecteur(1)">S1<small id="cnt-s1">0</small></button>
      <button class="secteur-btn" data-sect="2" onclick="filterSecteur(2)">S2<small id="cnt-s2">0</small></button>
      <button class="secteur-btn" data-sect="3" onclick="filterSecteur(3)">S3<small id="cnt-s3">0</small></button>
      <button class="secteur-btn" data-sect="4" onclick="filterSecteur(4)">S4<small id="cnt-s4">0</small></button>
      <button class="secteur-btn" data-sect="5" onclick="filterSecteur(5)">S5<small id="cnt-s5">0</small></button>
      <button class="secteur-btn" data-sect="6" onclick="filterSecteur(6)">S6<small id="cnt-s6">0</small></button>
    </div>

    <div class="search-wrap no-print">
      <span class="search-icon">🔍</span>
      <input type="text" placeholder="Rechercher une fontaine..." id="search-fontaine" oninput="renderFontaines()" style="background:#fff;">
    </div>

    <div class="fontaine-list" id="fontaine-list"></div>
  </div>

  <!-- ══ SECTION DÉTAIL FONTAINE ══ -->
  <div class="section" id="section-detail">
    <div class="detail-bar">
      <button class="back-btn" onclick="showSection('fontaines')">←</button>
      <div style="font-size:13px;color:var(--gris3);">Détail fontaine</div>
    </div>
    <div id="detail-content"></div>
  </div>

  <!-- ══ SECTION INTERVENTIONS ══ -->
  <div class="section" id="section-interventions">
    <div class="page-title"><span>🔧</span> Toutes les interventions</div>

    <div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;" class="no-print">
      <select id="filter-statut" onchange="renderInterventions()" style="padding:8px 12px;border:1.5px solid var(--gris1);border-radius:8px;font-family:inherit;font-size:13px;background:var(--blanc);">
        <option value="">Tous statuts</option>
        <option value="open">En cours</option>
        <option value="closed">Clôturées</option>
      </select>
      <select id="filter-sect-interv" onchange="renderInterventions()" style="padding:8px 12px;border:1.5px solid var(--gris1);border-radius:8px;font-family:inherit;font-size:13px;background:var(--blanc);">
        <option value="">Tous secteurs</option>
        <option value="1">Secteur 1</option>
        <option value="2">Secteur 2</option>
        <option value="3">Secteur 3</option>
        <option value="4">Secteur 4</option>
        <option value="5">Secteur 5</option>
        <option value="6">Secteur 6</option>
      </select>
    </div>

    <div class="interv-list" id="interventions-list"></div>
  </div>

  <!-- ══ SECTION AJOUTER ══ -->
  <div class="section" id="section-ajouter">
    <div class="page-title"><span>➕</span> Nouvelle intervention</div>

    <div class="card">
      <div class="card-header">
        <div class="card-icon vert">🔧</div>
        <div>
          <div class="card-title">Enregistrer une intervention</div>
          <div class="card-sub">La date est enregistrée automatiquement</div>
        </div>
      </div>
      <div class="card-body">
        <div class="form-group">
          <label>Fontaine *</label>
          <select id="form-fontaine">
            <option value="">— Sélectionner une fontaine —</option>
          </select>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Date *</label>
            <input type="date" id="form-date">
          </div>
          <div class="form-group">
            <label>Statut</label>
            <select id="form-statut">
              <option value="open">En cours / Signalement</option>
              <option value="closed">Terminée / Clôturée</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Description de l'intervention *</label>
          <textarea id="form-desc" placeholder="Ex: Pompe HS, fuite constatée, test chlore OK, nettoyage complet..."></textarea>
        </div>
        <div class="form-group">
          <label>Pièces / matériel utilisé</label>
          <input type="text" id="form-pieces" placeholder="Ex: Pompe centrifuge ref.XA200, joint torique...">
        </div>
        <button class="btn btn-vert btn-block" onclick="saveIntervention()">✅ Enregistrer l'intervention</button>
      </div>
    </div>

    <div class="card" style="margin-top:20px;">
      <div class="card-header">
        <div class="card-icon">⛲</div>
        <div>
          <div class="card-title">Ajouter une fontaine</div>
          <div class="card-sub">Créer une nouvelle fontaine dans la base</div>
        </div>
      </div>
      <div class="card-body">
        <div class="form-row">
          <div class="form-group">
            <label>Nom / Code fontaine *</label>
            <input type="text" id="form-fname" placeholder="Ex: PJM, VICTOR-HUGO...">
          </div>
          <div class="form-group">
            <label>Secteur *</label>
            <select id="form-fsect">
              <option value="1">Secteur 1</option>
              <option value="2">Secteur 2</option>
              <option value="3">Secteur 3</option>
              <option value="4">Secteur 4</option>
              <option value="5">Secteur 5</option>
              <option value="6">Secteur 6</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Adresse / Localisation</label>
          <input type="text" id="form-floc" placeholder="Ex: Place Jean Macé, Grenoble">
        </div>
        <button class="btn btn-primary btn-block" onclick="saveFontaine()">⛲ Créer la fontaine</button>
      </div>
    </div>
  </div>

  <!-- ══ SECTION EXPORT ══ -->
  <div class="section" id="section-export">
    <div class="page-title"><span>📄</span> Export compte-rendu PDF</div>

    <div class="card">
      <div class="card-header">
        <div class="card-icon orange">📅</div>
        <div>
          <div class="card-title">Paramètres du rapport</div>
          <div class="card-sub">Sélectionnez la période et les filtres</div>
        </div>
      </div>
      <div class="card-body">
        <div class="form-group">
          <label>Période</label>
          <div class="export-row" style="margin-bottom:8px;">
            <span class="filter-chip active" id="chip-all" onclick="setPeriod('all')">Tout</span>
            <span class="filter-chip" id="chip-month" onclick="setPeriod('month')">Ce mois</span>
            <span class="filter-chip" id="chip-custom" onclick="setPeriod('custom')">Personnalisé</span>
          </div>
          <div id="custom-dates" style="display:none;" class="form-row">
            <div class="form-group">
              <label>Du</label>
              <input type="date" id="export-from">
            </div>
            <div class="form-group">
              <label>Au</label>
              <input type="date" id="export-to">
            </div>
          </div>
        </div>

        <div class="form-group">
          <label>Secteur(s)</label>
          <div class="export-row" id="export-sect-chips">
            <span class="filter-chip active" data-sect="0" onclick="toggleSectChip(this,0)">Tous</span>
            <span class="filter-chip" data-sect="1" onclick="toggleSectChip(this,1)">Secteur 1</span>
            <span class="filter-chip" data-sect="2" onclick="toggleSectChip(this,2)">Secteur 2</span>
            <span class="filter-chip" data-sect="3" onclick="toggleSectChip(this,3)">Secteur 3</span>
            <span class="filter-chip" data-sect="4" onclick="toggleSectChip(this,4)">Secteur 4</span>
            <span class="filter-chip" data-sect="5" onclick="toggleSectChip(this,5)">Secteur 5</span>
            <span class="filter-chip" data-sect="6" onclick="toggleSectChip(this,6)">Secteur 6</span>
          </div>
        </div>

        <div class="form-group">
          <label>Statut</label>
          <div class="export-row">
            <span class="filter-chip active" id="chip-st-all" onclick="setStatutFilter('all')">Tous</span>
            <span class="filter-chip" id="chip-st-open" onclick="setStatutFilter('open')">En cours</span>
            <span class="filter-chip" id="chip-st-closed" onclick="setStatutFilter('closed')">Clôturées</span>
          </div>
        </div>

        <button class="btn btn-primary btn-block" onclick="generatePDF()" style="margin-top:8px;">🖨️ Générer et imprimer le PDF</button>
      </div>
    </div>
  </div>

  <!-- ══ SECTION DASHBOARD ══ -->
  <div class="section" id="section-dashboard">
    <div class="page-title"><span>📊</span> Tableau de bord</div>
    <div class="stats-grid" id="stats-grid"></div>
    <div id="dashboard-secteurs"></div>
  </div>

</main>

<!-- ══ MODAL RÉSOLUTION ══ -->
<div class="modal-overlay" id="modal-resol">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-header">
      <div style="font-size:22px;">✅</div>
      <h2>Clôturer l'intervention</h2>
      <button class="modal-close" onclick="closeModal('modal-resol')">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label>Date de résolution</label>
        <input type="date" id="resol-date">
      </div>
      <div class="form-group">
        <label>Description de la résolution *</label>
        <textarea id="resol-desc" placeholder="Ex: Remplacement pompe XA200, test OK, mise en service..."></textarea>
      </div>
      <div class="form-group">
        <label>Pièces utilisées / coût</label>
        <input type="text" id="resol-pieces" placeholder="Ex: Pompe ref.XA200 — 450€">
      </div>
      <div style="display:flex;gap:10px;">
        <button class="btn btn-ghost btn-block" onclick="closeModal('modal-resol')">Annuler</button>
        <button class="btn btn-vert btn-block" onclick="saveResolution()">Clôturer</button>
      </div>
    </div>
  </div>
</div>

<!-- ══ MODAL SUPPR ══ -->
<div class="modal-overlay" id="modal-del">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-header">
      <div style="font-size:22px;">🗑️</div>
      <h2>Supprimer ?</h2>
      <button class="modal-close" onclick="closeModal('modal-del')">✕</button>
    </div>
    <div class="modal-body">
      <p style="margin-bottom:16px;color:var(--gris3);">Cette action est irréversible.</p>
      <div style="display:flex;gap:10px;">
        <button class="btn btn-ghost btn-block" onclick="closeModal('modal-del')">Annuler</button>
        <button class="btn btn-danger btn-block" onclick="confirmDelete()">Supprimer</button>
      </div>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- ══ PRINT FRAME ══ -->
<div id="print-frame" style="display:none;"></div>

<script>
// ─────────────────────────────────────────────
//  STATE
// ─────────────────────────────────────────────
let state = {
  fontaines: [],
  interventions: [],
  currentSecteur: 0,
  exportPeriod: 'all',
  exportSecteurs: [0],
  exportStatut: 'all',
  pendingDelete: null,
  pendingResolId: null,
};

// ─────────────────────────────────────────────
//  LOCALSTORAGE
// ─────────────────────────────────────────────
function save() {
  localStorage.setItem('gre_fontaines', JSON.stringify(state.fontaines));
  localStorage.setItem('gre_interventions', JSON.stringify(state.interventions));
}
function load() {
  const f = localStorage.getItem('gre_fontaines');
  const i = localStorage.getItem('gre_interventions');
  if (f) state.fontaines = JSON.parse(f);
  if (i) state.interventions = JSON.parse(i);
}

// ─────────────────────────────────────────────
//  NAVIGATION
// ─────────────────────────────────────────────
function showSection(id) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
  document.getElementById('section-' + id).classList.add('active');
  const nb = document.getElementById('nav-' + id);
  if (nb) nb.classList.add('active');

  if (id === 'fontaines') renderFontaines();
  if (id === 'interventions') renderInterventions();
  if (id === 'ajouter') populateFontaineSelect();
  if (id === 'dashboard') renderDashboard();
}

// ─────────────────────────────────────────────
//  FONTAINES
// ─────────────────────────────────────────────
function filterSecteur(n) {
  state.currentSecteur = n;
  document.querySelectorAll('.secteur-btn').forEach(b => b.classList.remove('active'));
  document.querySelector(`.secteur-btn[data-sect="${n}"]`).classList.add('active');
  renderFontaines();
}

function renderFontaines() {
  updateSecteurCounts();
  const list = document.getElementById('fontaine-list');
  const q = (document.getElementById('search-fontaine').value || '').toLowerCase();
  let items = state.fontaines;
  if (state.currentSecteur !== 0) items = items.filter(f => f.secteur == state.currentSecteur);
  if (q) items = items.filter(f => f.nom.toLowerCase().includes(q) || (f.localisation||'').toLowerCase().includes(q));

  if (!items.length) {
    list.innerHTML = `<div class="empty-state"><div class="es-icon">⛲</div><h3>Aucune fontaine trouvée</h3><p>Ajoutez votre première fontaine dans l'onglet "Nouveau".</p></div>`;
    return;
  }

  list.innerHTML = items.map(f => {
    const intervsF = state.interventions.filter(i => i.fontaineId === f.id);
    const openCount = intervsF.filter(i => i.statut === 'open').length;
    const lastDate = intervsF.length ? intervsF.sort((a,b) => b.date.localeCompare(a.date))[0].date : null;
    return `<div class="fontaine-item" onclick="showDetail('${f.id}')">
      <div class="fi-alert ${openCount > 0 ? 'has-open' : ''}"></div>
      <div style="flex:1;">
        <div class="fi-name">${f.nom}</div>
        <div class="fi-interv">${f.localisation || ''} ${lastDate ? '· Dernière interv: '+formatDate(lastDate) : '· Aucune intervention'}</div>
      </div>
      <div class="fi-sect">S${f.secteur}</div>
      ${openCount > 0 ? `<div style="background:var(--orange);color:#fff;font-size:10px;font-weight:700;padding:2px 7px;border-radius:20px;">${openCount} en cours</div>` : ''}
    </div>`;
  }).join('');
}

function updateSecteurCounts() {
  for (let s = 1; s <= 6; s++) {
    const c = state.fontaines.filter(f => f.secteur == s).length;
    document.getElementById('cnt-s' + s).textContent = c + ' fonts';
  }
}

function showDetail(id) {
  const f = state.fontaines.find(f => f.id === id);
  if (!f) return;
  const intervs = state.interventions.filter(i => i.fontaineId === id).sort((a,b) => b.date.localeCompare(a.date));
  const openC = intervs.filter(i => i.statut === 'open').length;
  const closedC = intervs.filter(i => i.statut === 'closed').length;

  document.getElementById('detail-content').innerHTML = `
    <div class="fontaine-detail-header">
      <div class="fdh-sect">Secteur ${f.secteur}</div>
      <div class="fdh-name">${f.nom}</div>
      ${f.localisation ? `<div style="font-size:12px;opacity:.75;margin-top:4px;">📍 ${f.localisation}</div>` : ''}
      <div class="fdh-stats">
        <div class="fdh-stat"><div class="fdh-stat-val">${intervs.length}</div><div class="fdh-stat-lbl">Interventions</div></div>
        <div class="fdh-stat"><div class="fdh-stat-val">${openC}</div><div class="fdh-stat-lbl">En cours</div></div>
        <div class="fdh-stat"><div class="fdh-stat-val">${closedC}</div><div class="fdh-stat-lbl">Clôturées</div></div>
      </div>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
      <div style="font-size:15px;font-weight:700;color:var(--bleu);">Historique des interventions</div>
      <button class="btn btn-vert btn-sm" onclick="quickAddInterv('${f.id}')">+ Intervention</button>
    </div>

    ${intervs.length === 0 ? `<div class="empty-state"><div class="es-icon">🔧</div><h3>Aucune intervention</h3><p>Cette fontaine n'a pas encore d'intervention enregistrée.</p></div>` :
      `<div class="interv-list">${intervs.map(i => renderIntervCard(i)).join('')}</div>`}

    <div style="margin-top:16px;display:flex;gap:10px;">
      <button class="btn btn-ghost btn-sm" onclick="editFontaine('${f.id}')">✏️ Modifier</button>
      <button class="btn btn-sm" style="background:var(--rouge);color:#fff;" onclick="deleteFontaine('${f.id}')">🗑️ Supprimer</button>
    </div>
  `;

  showSection('detail');
  document.getElementById('nav-fontaines').classList.add('active');
}

function quickAddInterv(fontaineId) {
  populateFontaineSelect(fontaineId);
  showSection('ajouter');
}

function renderIntervCard(i) {
  const font = state.fontaines.find(f => f.id === i.fontaineId);
  return `<div class="interv-item ${i.statut}" id="icard-${i.id}">
    <div class="interv-header">
      <div class="interv-date">📅 ${formatDate(i.date)}</div>
      <div class="interv-desc">${i.description}</div>
      <div class="interv-status ${i.statut}">${i.statut === 'open' ? 'En cours' : 'Clôturée'}</div>
    </div>
    ${i.pieces ? `<div style="font-size:11px;color:var(--gris3);margin-top:4px;">🔩 ${i.pieces}</div>` : ''}
    ${i.resolution ? `<div class="interv-resolution">✅ ${formatDate(i.resolDate)} — ${i.resolution}${i.resolPieces ? ' — '+i.resolPieces : ''}</div>` : ''}
    <div class="interv-actions">
      ${i.statut === 'open' ? `<button class="btn btn-vert btn-sm" onclick="openResol('${i.id}')">✅ Clôturer</button>` : ''}
      <button class="btn btn-sm btn-ghost" onclick="deleteInterv('${i.id}')">🗑️ Supprimer</button>
    </div>
  </div>`;
}

// ─────────────────────────────────────────────
//  FONTAINE CRUD
// ─────────────────────────────────────────────
function saveFontaine() {
  const nom = document.getElementById('form-fname').value.trim().toUpperCase();
  const sect = document.getElementById('form-fsect').value;
  const loc = document.getElementById('form-floc').value.trim();
  if (!nom) { showToast('Nom de fontaine requis', 'error'); return; }
  if (state.fontaines.find(f => f.nom === nom)) { showToast('Cette fontaine existe déjà', 'error'); return; }
  state.fontaines.push({ id: uid(), nom, secteur: parseInt(sect), localisation: loc });
  save();
  document.getElementById('form-fname').value = '';
  document.getElementById('form-floc').value = '';
  showToast('⛲ Fontaine "' + nom + '" créée !', 'success');
  renderFontaines();
  populateFontaineSelect();
}

function deleteFontaine(id) {
  state.pendingDelete = { type: 'fontaine', id };
  document.getElementById('modal-del').classList.add('open');
}

function editFontaine(id) {
  const f = state.fontaines.find(f => f.id === id);
  if (!f) return;
  showSection('ajouter');
  document.getElementById('form-fname').value = f.nom;
  document.getElementById('form-fsect').value = f.secteur;
  document.getElementById('form-floc').value = f.localisation || '';
  // Mark as edit
  window._editFontaineId = id;
  showToast('Modifiez les champs puis re-cliquez "Créer"', '');
}

// ─────────────────────────────────────────────
//  INTERVENTIONS
// ─────────────────────────────────────────────
function populateFontaineSelect(selectedId) {
  const sel = document.getElementById('form-fontaine');
  sel.innerHTML = '<option value="">— Sélectionner une fontaine —</option>';
  const sorted = [...state.fontaines].sort((a,b) => a.secteur - b.secteur || a.nom.localeCompare(b.nom));
  sorted.forEach(f => {
    const o = document.createElement('option');
    o.value = f.id;
    o.textContent = `S${f.secteur} — ${f.nom}${f.localisation ? ' ('+f.localisation+')' : ''}`;
    if (selectedId && f.id === selectedId) o.selected = true;
    sel.appendChild(o);
  });
  // Set today's date
  document.getElementById('form-date').value = new Date().toISOString().split('T')[0];
}

function saveIntervention() {
  const fid = document.getElementById('form-fontaine').value;
  const date = document.getElementById('form-date').value;
  const desc = document.getElementById('form-desc').value.trim();
  const pieces = document.getElementById('form-pieces').value.trim();
  const statut = document.getElementById('form-statut').value;
  if (!fid) { showToast('Sélectionnez une fontaine', 'error'); return; }
  if (!date) { showToast('Date requise', 'error'); return; }
  if (!desc) { showToast('Description requise', 'error'); return; }
  const interv = { id: uid(), fontaineId: fid, date, description: desc, pieces, statut, createdAt: new Date().toISOString() };
  state.interventions.push(interv);
  save();
  document.getElementById('form-desc').value = '';
  document.getElementById('form-pieces').value = '';
  document.getElementById('form-fontaine').value = '';
  showToast('🔧 Intervention enregistrée !', 'success');
}

function renderInterventions() {
  const list = document.getElementById('interventions-list');
  let items = [...state.interventions].sort((a,b) => b.date.localeCompare(a.date));
  const filtStatut = document.getElementById('filter-statut').value;
  const filtSect = document.getElementById('filter-sect-interv').value;
  if (filtStatut) items = items.filter(i => i.statut === filtStatut);
  if (filtSect) {
    items = items.filter(i => {
      const f = state.fontaines.find(f => f.id === i.fontaineId);
      return f && f.secteur == filtSect;
    });
  }
  if (!items.length) {
    list.innerHTML = `<div class="empty-state"><div class="es-icon">🔧</div><h3>Aucune intervention</h3><p>Utilisez l'onglet "Nouveau" pour enregistrer une intervention.</p></div>`;
    return;
  }
  list.innerHTML = items.map(i => {
    const font = state.fontaines.find(f => f.id === i.fontaineId);
    return `<div class="interv-item ${i.statut}">
      <div class="interv-header">
        <div class="interv-date">📅 ${formatDate(i.date)}</div>
        <div class="interv-desc">${i.description}</div>
        <div class="interv-status ${i.statut}">${i.statut === 'open' ? 'En cours' : 'Clôturée'}</div>
      </div>
      ${font ? `<div class="interv-fontaine">⛲ ${font.nom} — Secteur ${font.secteur}${font.localisation ? ' · '+font.localisation : ''}</div>` : ''}
      ${i.pieces ? `<div style="font-size:11px;color:var(--gris3);margin-top:3px;">🔩 ${i.pieces}</div>` : ''}
      ${i.resolution ? `<div class="interv-resolution">✅ ${formatDate(i.resolDate)} — ${i.resolution}${i.resolPieces ? ' — '+i.resolPieces : ''}</div>` : ''}
      <div class="interv-actions">
        ${i.statut === 'open' ? `<button class="btn btn-vert btn-sm" onclick="openResol('${i.id}')">✅ Clôturer</button>` : ''}
        <button class="btn btn-sm btn-ghost" onclick="deleteInterv('${i.id}')">🗑️ Supprimer</button>
      </div>
    </div>`;
  }).join('');
}

function openResol(id) {
  state.pendingResolId = id;
  document.getElementById('resol-date').value = new Date().toISOString().split('T')[0];
  document.getElementById('resol-desc').value = '';
  document.getElementById('resol-pieces').value = '';
  document.getElementById('modal-resol').classList.add('open');
}

function saveResolution() {
  const desc = document.getElementById('resol-desc').value.trim();
  const date = document.getElementById('resol-date').value;
  const pieces = document.getElementById('resol-pieces').value.trim();
  if (!desc) { showToast('Description de résolution requise', 'error'); return; }
  const i = state.interventions.find(i => i.id === state.pendingResolId);
  if (i) {
    i.statut = 'closed';
    i.resolution = desc;
    i.resolDate = date;
    i.resolPieces = pieces;
    save();
    showToast('✅ Intervention clôturée !', 'success');
    closeModal('modal-resol');
    renderInterventions();
  }
}

function deleteInterv(id) {
  state.pendingDelete = { type: 'interv', id };
  document.getElementById('modal-del').classList.add('open');
}

function confirmDelete() {
  if (!state.pendingDelete) return;
  if (state.pendingDelete.type === 'fontaine') {
    state.fontaines = state.fontaines.filter(f => f.id !== state.pendingDelete.id);
    state.interventions = state.interventions.filter(i => i.fontaineId !== state.pendingDelete.id);
    showToast('Fontaine supprimée', 'success');
    showSection('fontaines');
  } else {
    state.interventions = state.interventions.filter(i => i.id !== state.pendingDelete.id);
    showToast('Intervention supprimée', 'success');
    renderInterventions();
  }
  save();
  closeModal('modal-del');
  state.pendingDelete = null;
}

// ─────────────────────────────────────────────
//  EXPORT PDF
// ─────────────────────────────────────────────
let exportSectSet = new Set([0]);

function setPeriod(p) {
  state.exportPeriod = p;
  document.querySelectorAll('#chip-all,#chip-month,#chip-custom').forEach(c => c.classList.remove('active'));
  document.getElementById('chip-' + p).classList.add('active');
  document.getElementById('custom-dates').style.display = p === 'custom' ? 'grid' : 'none';
}

function toggleSectChip(el, s) {
  if (s === 0) {
    exportSectSet.clear(); exportSectSet.add(0);
    document.querySelectorAll('#export-sect-chips .filter-chip').forEach(c => c.classList.remove('active'));
    el.classList.add('active');
  } else {
    exportSectSet.delete(0);
    document.querySelector('#export-sect-chips [data-sect="0"]').classList.remove('active');
    if (el.classList.contains('active')) { el.classList.remove('active'); exportSectSet.delete(s); }
    else { el.classList.add('active'); exportSectSet.add(s); }
    if (exportSectSet.size === 0) { exportSectSet.add(0); document.querySelector('#export-sect-chips [data-sect="0"]').classList.add('active'); }
  }
}

function setStatutFilter(s) {
  state.exportStatut = s;
  document.querySelectorAll('#chip-st-all,#chip-st-open,#chip-st-closed').forEach(c => c.classList.remove('active'));
  document.getElementById('chip-st-' + s).classList.add('active');
}

function generatePDF() {
  // Filter interventions
  let items = [...state.interventions].sort((a,b) => b.date.localeCompare(a.date));
  
  if (state.exportPeriod === 'month') {
    const now = new Date(); const ym = now.toISOString().slice(0,7);
    items = items.filter(i => i.date.startsWith(ym));
  } else if (state.exportPeriod === 'custom') {
    const from = document.getElementById('export-from').value;
    const to = document.getElementById('export-to').value;
    if (from) items = items.filter(i => i.date >= from);
    if (to)   items = items.filter(i => i.date <= to);
  }
  if (!exportSectSet.has(0)) {
    items = items.filter(i => {
      const f = state.fontaines.find(f => f.id === i.fontaineId);
      return f && exportSectSet.has(f.secteur);
    });
  }
  if (state.exportStatut !== 'all') {
    items = items.filter(i => i.statut === state.exportStatut);
  }

  const now = new Date();
  const dateStr = now.toLocaleDateString('fr-FR', {day:'2-digit',month:'long',year:'numeric'});
  const sectStr = exportSectSet.has(0) ? 'Tous les secteurs' : [...exportSectSet].map(s=>'Secteur '+s).join(', ');

  let periodStr = 'Toutes les interventions';
  if (state.exportPeriod === 'month') periodStr = now.toLocaleDateString('fr-FR', {month:'long',year:'numeric'});
  else if (state.exportPeriod === 'custom') {
    const f = document.getElementById('export-from').value;
    const t = document.getElementById('export-to').value;
    periodStr = (f ? 'Du '+formatDate(f) : '') + (t ? ' au '+formatDate(t) : '');
  }

  // Group by secteur then fontaine
  const grouped = {};
  items.forEach(i => {
    const font = state.fontaines.find(f => f.id === i.fontaineId);
    const sect = font ? font.secteur : 0;
    const fname = font ? font.nom : 'Inconnue';
    if (!grouped[sect]) grouped[sect] = {};
    if (!grouped[sect][fname]) grouped[sect][fname] = [];
    grouped[sect][fname].push({ ...i, font });
  });

  const openC = items.filter(i=>i.statut==='open').length;
  const closedC = items.filter(i=>i.statut==='closed').length;

  let tableRows = '';
  let hasSomething = false;
  Object.keys(grouped).sort().forEach(sect => {
    tableRows += `<tr style="background:#1a3a6b;color:#fff;"><td colspan="4" style="padding:10px 12px;font-weight:700;font-size:13px;letter-spacing:.5px;">SECTEUR ${sect}</td></tr>`;
    Object.keys(grouped[sect]).sort().forEach(fname => {
      hasSomething = true;
      tableRows += `<tr style="background:#e8f0fa;"><td colspan="4" style="padding:7px 12px;font-weight:700;font-size:12px;color:#1a3a6b;">⛲ ${fname}${grouped[sect][fname][0].font?.localisation ? ' — '+grouped[sect][fname][0].font.localisation : ''}</td></tr>`;
      grouped[sect][fname].forEach(i => {
        const statusStyle = i.statut === 'open' ? 'color:#e67e22;font-weight:700;' : 'color:#007a4d;font-weight:700;';
        tableRows += `<tr>
          <td style="padding:7px 12px;font-size:12px;">${formatDate(i.date)}</td>
          <td style="padding:7px 12px;font-size:12px;">${i.description}${i.pieces ? '<br><span style="color:#666;font-size:11px;">🔩 '+i.pieces+'</span>' : ''}</td>
          <td style="padding:7px 12px;font-size:12px;${statusStyle}">${i.statut==='open'?'En cours':'Clôturée'}</td>
          <td style="padding:7px 12px;font-size:11px;color:#555;">${i.resolution ? '✅ '+formatDate(i.resolDate)+'<br>'+i.resolution+(i.resolPieces?'<br>'+i.resolPieces:'') : '—'}</td>
        </tr>`;
      });
    });
  });

  if (!hasSomething) { showToast('Aucune intervention pour ces critères', 'error'); return; }

  const html = `<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8">
<title>Compte-rendu Interventions Fontaines — Grenoble</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&display=swap');
  * { box-sizing:border-box; margin:0; padding:0; }
  body { font-family:'Source Sans 3',sans-serif; color:#1c2833; background:#fff; }
  .page { max-width:900px; margin:0 auto; padding:30px; }
  .header { display:flex; align-items:center; gap:20px; padding-bottom:20px; border-bottom:3px solid #1a3a6b; margin-bottom:24px; }
  .logo-circle { width:60px;height:60px;background:linear-gradient(135deg,#1a3a6b,#007a4d);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:30px;flex-shrink:0; }
  .header-text h1 { font-size:22px;font-weight:700;color:#1a3a6b; }
  .header-text p { font-size:13px;color:#666;margin-top:3px; }
  .header-right { margin-left:auto;text-align:right; }
  .header-right .date { font-size:12px;color:#888; }
  .header-right .stamp { font-size:11px;color:#1a3a6b;font-weight:700;margin-top:4px;background:#e8f0fa;padding:4px 10px;border-radius:4px; }
  .meta-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px; }
  .meta-box { background:#f5f6f7;border-radius:8px;padding:12px;text-align:center;border-top:3px solid #1a3a6b; }
  .meta-box.vert { border-top-color:#007a4d; }
  .meta-box.orange { border-top-color:#e67e22; }
  .meta-val { font-size:24px;font-weight:700;color:#1a3a6b; }
  .meta-val.vert { color:#007a4d; }
  .meta-val.orange { color:#e67e22; }
  .meta-lbl { font-size:10px;color:#888;margin-top:3px;text-transform:uppercase;letter-spacing:.5px; }
  .section-title { font-size:14px;font-weight:700;color:#1a3a6b;margin-bottom:10px;display:flex;align-items:center;gap:6px; }
  table { width:100%;border-collapse:collapse;margin-bottom:24px;font-size:12px; }
  th { background:#1a3a6b;color:#fff;padding:10px 12px;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.5px; }
  td { border-bottom:1px solid #eee;vertical-align:top; }
  tr:hover td { background:#f9f9f9; }
  .footer { margin-top:30px;padding-top:16px;border-top:1px solid #eee;display:flex;justify-content:space-between;font-size:11px;color:#aaa; }
  @media print { body{-webkit-print-color-adjust:exact;print-color-adjust:exact;} }
</style></head><body><div class="page">
  <div class="header">
    <div class="logo-circle">⛲</div>
    <div class="header-text">
      <h1>Compte-rendu des Interventions — Fontaines</h1>
      <p>Service Hydraulique · Ville de Grenoble</p>
    </div>
    <div class="header-right">
      <div class="date">Édité le ${dateStr}</div>
      <div class="stamp">DOCUMENT OFFICIEL</div>
    </div>
  </div>

  <div class="meta-grid">
    <div class="meta-box"><div class="meta-val">${items.length}</div><div class="meta-lbl">Total interventions</div></div>
    <div class="meta-box orange"><div class="meta-val orange">${openC}</div><div class="meta-lbl">En cours</div></div>
    <div class="meta-box vert"><div class="meta-val vert">${closedC}</div><div class="meta-lbl">Clôturées</div></div>
    <div class="meta-box"><div class="meta-val" style="font-size:14px;">${sectStr}</div><div class="meta-lbl">Périmètre</div></div>
  </div>

  <div style="background:#e8f0fa;border-radius:8px;padding:12px 16px;margin-bottom:20px;font-size:13px;color:#1a3a6b;">
    <strong>Période :</strong> ${periodStr} &nbsp;·&nbsp; <strong>Secteur(s) :</strong> ${sectStr} &nbsp;·&nbsp; <strong>Statut :</strong> ${state.exportStatut==='all'?'Tous':state.exportStatut==='open'?'En cours':'Clôturées'}
  </div>

  <table>
    <thead><tr>
      <th style="width:100px;">Date</th>
      <th>Description de l'intervention</th>
      <th style="width:90px;">Statut</th>
      <th style="width:180px;">Résolution</th>
    </tr></thead>
    <tbody>${tableRows}</tbody>
  </table>

  <div class="footer">
    <span>Ville de Grenoble — Service Hydraulique — Suivi des Fontaines</span>
    <span>Document généré le ${dateStr}</span>
  </div>
</div></body></html>`;

  const w = window.open('', '_blank');
  w.document.write(html);
  w.document.close();
  w.onload = () => { w.focus(); w.print(); };
  showToast('📄 PDF en cours de génération...', 'success');
}

// ─────────────────────────────────────────────
//  DASHBOARD
// ─────────────────────────────────────────────
function renderDashboard() {
  const totalF = state.fontaines.length;
  const totalI = state.interventions.length;
  const openI  = state.interventions.filter(i=>i.statut==='open').length;
  const closedI = state.interventions.filter(i=>i.statut==='closed').length;

  document.getElementById('stats-grid').innerHTML = `
    <div class="stat-card"><div class="stat-val">${totalF}</div><div class="stat-lbl">Fontaines</div></div>
    <div class="stat-card"><div class="stat-val">${totalI}</div><div class="stat-lbl">Interventions</div></div>
    <div class="stat-card"><div class="stat-val orange">${openI}</div><div class="stat-lbl">En cours</div></div>
    <div class="stat-card"><div class="stat-val vert">${closedI}</div><div class="stat-lbl">Clôturées</div></div>
  `;

  let sectHtml = '';
  for (let s = 1; s <= 6; s++) {
    const fonts = state.fontaines.filter(f=>f.secteur===s);
    const intervsS = state.interventions.filter(i => fonts.find(f=>f.id===i.fontaineId));
    const openS = intervsS.filter(i=>i.statut==='open').length;
    if (fonts.length === 0) continue;
    sectHtml += `
    <div class="card" style="margin-bottom:12px;">
      <div class="card-header">
        <div class="card-icon ${openS>0?'orange':'vert'}">S${s}</div>
        <div>
          <div class="card-title">Secteur ${s}</div>
          <div class="card-sub">${fonts.length} fontaine${fonts.length>1?'s':''} · ${intervsS.length} intervention${intervsS.length>1?'s':''}</div>
        </div>
        ${openS>0?`<div style="margin-left:auto;background:#fff3e0;color:var(--orange);font-size:12px;font-weight:700;padding:4px 10px;border-radius:20px;">${openS} en cours</div>`:''}
      </div>
      <div class="card-body">
        <div class="fontaine-list">${fonts.map(f=>{
          const fi = state.interventions.filter(i=>i.fontaineId===f.id);
          const fopen = fi.filter(i=>i.statut==='open').length;
          return `<div class="fontaine-item" onclick="showDetail('${f.id}')">
            <div class="fi-alert ${fopen>0?'has-open':''}"></div>
            <div style="flex:1;"><div class="fi-name">${f.nom}</div><div class="fi-interv">${f.localisation||''}</div></div>
            <div style="font-size:12px;color:var(--gris3);">${fi.length} interv.</div>
          </div>`;
        }).join('')}</div>
      </div>
    </div>`;
  }
  document.getElementById('dashboard-secteurs').innerHTML = sectHtml || `<div class="empty-state"><div class="es-icon">📊</div><h3>Aucune donnée</h3><p>Ajoutez des fontaines pour voir le tableau de bord.</p></div>`;
}

// ─────────────────────────────────────────────
//  UTILS
// ─────────────────────────────────────────────
function uid() { return Math.random().toString(36).slice(2,10) + Date.now().toString(36); }
function formatDate(d) {
  if (!d) return '—';
  const [y,m,day] = d.split('-');
  const months = ['jan','fév','mar','avr','mai','jun','jul','aoû','sep','oct','nov','déc'];
  return `${parseInt(day)} ${months[parseInt(m)-1]} ${y}`;
}
function showToast(msg, type) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show' + (type ? ' '+type : '');
  setTimeout(() => t.classList.remove('show'), 2800);
}
function closeModal(id) {
  document.getElementById(id).classList.remove('open');
}

// Close modals on overlay click
document.querySelectorAll('.modal-overlay').forEach(o => {
  o.addEventListener('click', e => { if (e.target === o) o.classList.remove('open'); });
});

// ─────────────────────────────────────────────
//  OFFLINE
// ─────────────────────────────────────────────
function checkOnline() {
  document.getElementById('offline-badge').classList.toggle('show', !navigator.onLine);
}
window.addEventListener('online', checkOnline);
window.addEventListener('offline', checkOnline);

// ─────────────────────────────────────────────
//  SERVICE WORKER (PWA)
// ─────────────────────────────────────────────
if ('serviceWorker' in navigator) {
  const swCode = `
const CACHE='fontaines-v1';
const FILES=['/'];
self.addEventListener('install',e=>e.waitUntil(caches.open(CACHE).then(c=>c.addAll(FILES))));
self.addEventListener('fetch',e=>e.respondWith(caches.match(e.request).then(r=>r||fetch(e.request).catch(()=>new Response('Hors ligne',{headers:{'Content-Type':'text/plain'}})))));
  `;
  const blob = new Blob([swCode], {type:'application/javascript'});
  const swUrl = URL.createObjectURL(blob);
  navigator.serviceWorker.register(swUrl).catch(()=>{});
}

// ─────────────────────────────────────────────
//  INIT
// ─────────────────────────────────────────────
load();
renderFontaines();
checkOnline();
populateFontaineSelect();
</script>
</body>
</html>
